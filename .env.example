# Copy to .env for local development. Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Local publisher only; never deploy or expose this value.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
SUPABASE_CAMPAIGN_KEY=initiative
SUPABASE_CAMPAIGN_NAME=the Initiative Campaign
SUPABASE_OBSERVER_FACTION_ID=4712
SUPABASE_HISTORY_RETENTION=20
SUPABASE_FULL_SNAPSHOT_RETENTION=3

# Optional local overrides.
TI_SAVE_PATH=C:/path/to/TerraInvicta/Saves
TI_TEMPLATES_DIR=C:/path/to/TerraInvicta/TerraInvicta_Data/StreamingAssets/Templates
TI_DEFAULT_MODE=player
