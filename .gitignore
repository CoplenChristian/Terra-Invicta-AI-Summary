# Terra Invicta AI Summary & Dashboard - Git Ignore

# Environment and secrets (CRITICAL: Never commit credentials!)
.env
.env.local
.env.*.local
*.pem
*.key

# Local configuration and dev files
config.json
template.config.local

# Dependency and build directories
node_modules/
dist/
public/v2/app/
# build/harness/ is the React primitives test harness bundle. It lives outside
# public/ so `npm run build`'s emptyOutDir on public/v2/app cannot delete it
# mid-test, and so build_static_snapshot.js does not copy 718 KB of test-only
# code into dist/. See vite.primitives.config.mjs.
build/
tmp/

# Save files and large binaries
*.gz
*.json.gz
*.tgz
Again
Spaceships*

# Generated CSVs and exports from md-generation-reports/ (the 2025 report tool).
# These paths are anchored, so they moved with the tool -- leaving them at the
# root would have started tracking every generated CSV and snippet pack.
md-generation-reports/csv/*.csv
!md-generation-reports/csv/README.md
md-generation-reports/Again_Save/snippet_pack/*
!md-generation-reports/Again_Save/snippet_pack/README.md
md-generation-reports/Again_Save/summary/*
!md-generation-reports/Again_Save/summary/README.md

# The tool's PRE-MOVE output locations. Anchoring the patterns above to
# md-generation-reports/ un-ignored these, and a `git add -A` then swept 45
# generated CSVs into the repo. Any checkout that ran the tool before the move
# still has output here, so these stay ignored even though nothing is tracked
# under them. tests/repoStructure.test.js asserts the tracked side.
csv/
Again_Save/
logs/

# Local Supabase snapshot exports (safety net before pruning; can be large)
backups/

# Local agent tool state — .opencode/supabase-auth.json holds live OAuth tokens
.opencode/

# Agent worktrees are created inside the repo by the harness and are not part of it.
# Without this, `git status` shows tens of thousands of untracked files and a
# `git add -A` would sweep an entire second checkout into a commit.
.claude/worktrees/

# Claude Code personal overrides. settings.json is the shared file; .local.json is
# per-machine by convention and here it installs auto-running edit hooks.
.claude/settings.local.json

# Git worktrees created by tooling — never part of a commit.
# `.claude/worktrees/` is covered above; this catches the sibling path that
# a `git add -A` once swept in as an embedded gitlink.
.worktrees/
